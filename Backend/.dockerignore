# Python bytecode & caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments (never copy into image)
.venv/
venv/
env/

# uv cache
.uv/

# .env files (inject via Render environment variables instead)
.env
.env.*

# Testing & notebooks
*.ipynb
.pytest_cache/
.coverage

# Model training scripts (not needed at runtime)
MODEL_TRAINIG/

# SQLite dev database (Render filesystem is ephemeral anyway)
kitech_elite_server/db.sqlite3

# Git
.git/
.gitignore

# Logs & temp files
*.log
*.tmp

# IDE
.vscode/
.idea/
